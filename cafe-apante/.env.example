# Configuración opcional. El sistema funciona sin este archivo.
# Si necesita cambiar algo, copie este archivo con el nombre ".env" y quite el "#" de la línea.

# Puerto en que se abre el sistema (http://localhost:3000)
# PUERTO=3000

# Instancia de SQL Server Express y nombre de la base de datos
# SQL_SERVIDOR=.\SQLEXPRESS01
# SQL_BASE=CafeApante

# Controlador ODBC instalado en la laptop
# SQL_DRIVER=ODBC Driver 18 for SQL Server
